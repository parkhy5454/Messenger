# 로컬 실행용 예시 (실제 값은 .env 또는 Render 환경 변수에 입력)
DATABASE_URL=postgres://msg:msgpass@localhost:5432/messenger   # Neon 사용 시: postgres://...neon.tech/...?sslmode=require
JWT_SECRET=change-this-to-a-long-random-string
PGSSL=false   # Neon 사용 시 true
PORT=3000

# 이메일 인증 메일 발송 (비우면 인증 코드가 서버 로그에만 출력됩니다)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Messenger" <your-gmail@gmail.com>

# 카카오 로그인 (비우면 카카오 버튼이 501 응답)
KAKAO_REST_KEY=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
